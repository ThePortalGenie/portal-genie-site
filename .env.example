# Genie chat widget — copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables (see notes per variable).

# Master switch. Only the literal value "true" enables Genie.
GENIE_ENABLED=true

# Server-side OpenAI key. NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model override (defaults to gpt-4.1-mini when unset).
# GENIE_MODEL=gpt-4.1-mini

# --- Zoho CRM (server-only — NEVER prefix with NEXT_PUBLIC_) ---
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_BASE_URL=https://www.zohoapis.com
#
# EU example:
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
# ZOHO_API_BASE_URL=https://www.zohoapis.eu
#
# OAuth scopes required by the live refresh token:
# ZohoCRM.modules.leads.READ/CREATE/UPDATE
# ZohoCRM.modules.contacts.READ/UPDATE
# ZohoCRM.modules.notes.CREATE/READ
#
# Genie enquiry team notifications are handled by Zoho CRM native workflows
# triggered when a Genie Note is added to the resolved Contact or Lead record.

# --- Client Portal Demo lead gate (server-only) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# DEMO_FROM_EMAIL=Portal Genie Demo <demo@demo.theportalgenie.com>
# NEXT_PUBLIC_APP_URL=https://demo.theportalgenie.com
#
# Development only — skip demo gate locally (never enable in production):
# DEMO_ACCESS_BYPASS=true
