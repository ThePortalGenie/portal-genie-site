# Genie chat widget — copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables (see notes per variable).

# Master switch. Only the literal value "true" enables Genie.
GENIE_ENABLED=true

# Server-side OpenAI key. NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model override (defaults to gpt-4.1-mini when unset).
# GENIE_MODEL=gpt-4.1-mini

# --- Zoho CRM (server-only — NEVER prefix with NEXT_PUBLIC_) ---
# Required for CRM integration after OAuth bootstrap is complete:
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_REDIRECT_URI=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_BASE_URL=https://www.zohoapis.com
#
# EU example:
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
# ZOHO_API_BASE_URL=https://www.zohoapis.eu
#
# Temporary — protects /api/zoho/oauth/start and /api/zoho/verify during setup.
# Remove or rotate after ZOHO_REFRESH_TOKEN is saved in Vercel.
# ZOHO_OAUTH_SETUP_SECRET=
#
# OAuth scopes include Leads + Contacts + Notes permissions. After changing scopes,
# re-run /api/zoho/oauth/start to obtain a new ZOHO_REFRESH_TOKEN.
#
# Optional Zoho CRM web URL base for notification emails (server-only), e.g.
# https://crm.zoho.com/crm/org123456789
# ZOHO_CRM_WEB_BASE_URL=
#
# --- Genie enquiry notifications (server-only) ---
# GENIE_ENQUIRY_NOTIFICATION_EMAIL=
# GENIE_ENQUIRY_NOTIFICATION_FROM=Portal Genie <notifications@yourdomain.com>
# RESEND_API_KEY=
